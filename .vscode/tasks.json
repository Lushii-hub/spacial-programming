{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Instalar y ejecutar Cosmic Adventure",
            "type": "process",
            "command": "cmd.exe",
            "args": [
                "/c",
                "${workspaceFolder}\\1_INSTALAR_Y_ABRIR_JUEGO.bat"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Ejecutar juego sin reinstalar",
            "type": "process",
            "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
            "args": [
                "${workspaceFolder}\\watch.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
